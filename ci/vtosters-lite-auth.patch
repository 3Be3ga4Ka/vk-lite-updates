--- /dev/null
+++ b/app/src/main/java/ru/vtosters/lite/ui/activities/WebCaptchaActivity.java
@@ -0,0 +1,202 @@
+package ru.vtosters.lite.ui.activities;
+
+import android.app.Activity;
+import android.hardware.Sensor;
+import android.hardware.SensorEvent;
+import android.hardware.SensorEventListener;
+import android.hardware.SensorManager;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.webkit.JavascriptInterface;
+import android.webkit.WebResourceError;
+import android.webkit.WebResourceRequest;
+import android.webkit.WebResourceResponse;
+import android.webkit.WebSettings;
+import android.webkit.WebView;
+import android.webkit.WebViewClient;
+import org.json.JSONException;
+import org.json.JSONArray;
+import org.json.JSONObject;
+import ru.vtosters.hooks.CaptchaHook;
+
+/** Displays VK's challenge for the user; never solves or skips it automatically. */
+public final class WebCaptchaActivity extends Activity implements SensorEventListener {
+    private String sessionId;
+    private WebView webView;
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private final Runnable expiry = this::finish;
+    private SensorManager sensors;
+    private JSONObject sensorConfig;
+    private final java.util.Map<Integer, String> sensorNames = new java.util.HashMap<>();
+    private boolean resumed;
+
+    @Override
+    protected void onCreate(Bundle state) {
+        super.onCreate(state);
+        sessionId = getIntent().getStringExtra("captcha_session");
+        String redirect = CaptchaHook.redirect(sessionId);
+        if (!CaptchaHook.isPending(sessionId) || !CaptchaHook.isTrustedUrl(redirect)) {
+            finish();
+            return;
+        }
+        setTitle("VK CAPTCHA");
+        sensors = (SensorManager) getSystemService(SENSOR_SERVICE);
+        webView = new WebView(this);
+        WebSettings settings = webView.getSettings();
+        settings.setJavaScriptEnabled(true);
+        settings.setDomStorageEnabled(true);
+        settings.setAllowFileAccess(false);
+        settings.setAllowContentAccess(false);
+        settings.setMixedContentMode(WebSettings.MIXED_CONTENT_NEVER_ALLOW);
+        webView.addJavascriptInterface(new Bridge(), "AndroidBridge");
+        webView.setWebViewClient(new WebViewClient() {
+            @Override
+            public boolean shouldOverrideUrlLoading(WebView view, String url) {
+                return !CaptchaHook.isTrustedUrl(url);
+            }
+
+            @Override
+            public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {
+                return !CaptchaHook.isTrustedUrl(request.getUrl().toString());
+            }
+
+            @Override
+            public void onReceivedError(WebView view, WebResourceRequest request, WebResourceError error) {
+                if (request.isForMainFrame()) finish();
+            }
+
+            @Override
+            public void onReceivedError(WebView view, int code, String description, String url) {
+                finish();
+            }
+
+            @Override
+            public void onReceivedHttpError(WebView view, WebResourceRequest request, WebResourceResponse response) {
+                if (request.isForMainFrame()) finish();
+            }
+        });
+        setContentView(webView);
+        webView.loadUrl(redirect);
+        handler.postDelayed(expiry, 5 * 60 * 1000L);
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        resumed = true;
+        startSensors();
+    }
+
+    @Override
+    protected void onPause() {
+        resumed = false;
+        stopSensors();
+        super.onPause();
+    }
+
+    private void stopSensors() {
+        if (sensors != null) sensors.unregisterListener(this);
+        sensorNames.clear();
+    }
+
+    private void startSensors() {
+        stopSensors();
+        if (!resumed || sensors == null || sensorConfig == null || !CaptchaHook.isPending(sessionId)) return;
+        JSONArray requested = sensorConfig.optJSONArray("bridge_sensors_list");
+        if (requested == null) return;
+        int period = Math.max(20, Math.min(1000, sensorConfig.optInt("period", 100)));
+        for (int i = 0; i < requested.length(); i++) {
+            String name = requested.optString(i);
+            int type;
+            switch (name) {
+                case "accelerometer": type = Sensor.TYPE_ACCELEROMETER; break;
+                case "gyroscope": type = Sensor.TYPE_GYROSCOPE; break;
+                case "motion": type = Sensor.TYPE_ROTATION_VECTOR; break;
+                default: continue;
+            }
+            Sensor sensor = sensors.getDefaultSensor(type);
+            if (sensor != null && sensors.registerListener(this, sensor, period * 1000, handler)) {
+                sensorNames.put(type, name);
+            }
+        }
+    }
+
+    @Override
+    public void onSensorChanged(SensorEvent event) {
+        String name = sensorNames.get(event.sensor.getType());
+        if (!resumed || name == null || event.values.length < 3 || webView == null) return;
+        try {
+            JSONObject values = new JSONObject();
+            String[] axes = "motion".equals(name)
+                    ? new String[]{"alpha", "beta", "gamma"} : new String[]{"x", "y", "z"};
+            for (int i = 0; i < axes.length; i++) values.put(axes[i], (double) event.values[i]);
+            JSONObject data = new JSONObject().put("detail", new JSONObject().put(name, values));
+            webView.evaluateJavascript("window.dispatchEvent(new CustomEvent('VKCaptchaListenSensorsChanged',"
+                    + data + "))", null);
+        } catch (JSONException ignored) {
+            // Never substitute manufactured readings for unavailable sensor data.
+        }
+    }
+
+    @Override
+    public void onAccuracyChanged(Sensor sensor, int accuracy) {}
+
+    @Override
+    protected void onDestroy() {
+        handler.removeCallbacks(expiry);
+        stopSensors();
+        if (!isChangingConfigurations()) CaptchaHook.complete(sessionId, null);
+        if (webView != null) {
+            webView.removeJavascriptInterface("AndroidBridge");
+            webView.stopLoading();
+            webView.destroy();
+        }
+        super.onDestroy();
+    }
+
+    /** Names and token payload follow VK Captcha's AndroidBridge contract. */
+    public final class Bridge {
+        @JavascriptInterface
+        public void VKCaptchaGetResult(String data) {
+            try {
+                Object value = new JSONObject(data).opt("token");
+                if (!(value instanceof String) || ((String) value).isEmpty()) return;
+                runOnUiThread(() -> {
+                    if (isFinishing() || isDestroyed()) return;
+                    CaptchaHook.complete(sessionId, (String) value);
+                    finish();
+                });
+            } catch (JSONException | NullPointerException ignored) {
+                // An invalid message must not turn into a successful challenge.
+            }
+        }
+
+        @JavascriptInterface
+        public void VKCaptchaCloseCaptcha(String data) {
+            runOnUiThread(WebCaptchaActivity.this::finish);
+        }
+
+        @JavascriptInterface
+        public void VKCaptchaListenSensorsStart(String data) {
+            try {
+                JSONObject config = new JSONObject(data);
+                runOnUiThread(() -> {
+                    if (isFinishing() || isDestroyed()) return;
+                    sensorConfig = config;
+                    startSensors();
+                });
+            } catch (JSONException | NullPointerException ignored) {
+                // Ignore malformed bridge requests.
+            }
+        }
+
+        @JavascriptInterface
+        public void VKCaptchaListenSensorsStop(String data) {
+            runOnUiThread(() -> {
+                sensorConfig = null;
+                stopSensors();
+            });
+        }
+    }
+}
