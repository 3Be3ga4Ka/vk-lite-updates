@@ -0,0 +1,70 @@
+package ru.vtosters.hooks;
+
+import com.vk.api.sdk.VKApiConfig;
+import com.vk.api.sdk.VKApiValidationHandler;
+import com.vk.api.sdk.chain.ChainArgs;
+import com.vk.api.sdk.exceptions.VKApiExecutionException;
+import com.vk.api.sdk.okhttp.OkHttpExecutorConfig;
+import com.vk.auth.api.VKAuthOkHttpExecutor;
+import com.vk.auth.api.b.OAuthHttpUrlPostCall;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import okhttp3.Request;
+import okhttp3.Response;
+import org.json.JSONObject;
+
+/** Keeps Lite's configured network client, proxy and existing validation UI. */
+public final class ModernAuthExecutor extends VKAuthOkHttpExecutor {
+    private final VKApiConfig config;
+    private final ModernAuthFlow flow;
+    private final ThreadLocal<Long> timeout = new ThreadLocal<>();
+
+    public ModernAuthExecutor(OkHttpExecutorConfig executorConfig, VKApiConfig config) {
+        super(executorConfig);
+        this.config = config;
+        flow = new ModernAuthFlow(this::send, this::captcha, config.g().getValue(),
+                config.o(), config.h(), config.f().getValue());
+    }
+
+    @Override public String a(OAuthHttpUrlPostCall call, ChainArgs args) {
+        timeout.set(call.b() + e());
+        try {
+            return flow.execute(call.c(), args);
+        } catch (Exception error) {
+            // Kotlin's executor API does not declare checked exceptions. Preserve them
+            // for the SDK's existing exception/validation chain instead of wrapping.
+            return ModernAuthExecutor.<RuntimeException, String>raise(error);
+        } finally {
+            timeout.remove();
+        }
+    }
+
+    private String send(Request request) throws Exception {
+        long duration = timeout.get();
+        Response response = a(request, duration);
+        Request retry = CaptchaHook.challengeRequest(response);
+        if (retry != null) response = a(retry, duration);
+        return a(response);
+    }
+
+    private void captcha(JSONObject answer, ChainArgs args) throws Exception {
+        VKApiExecutionException error = new VKApiExecutionException(14, "auth.getAnonymToken",
+                false, "need_captcha", CaptchaHook.extras(answer), null, null);
+        if (CaptchaHook.handle(error, args)) return;
+        String image = answer.optString("captcha_img");
+        String sid = answer.optString("captcha_sid");
+        VKApiValidationHandler handler = config.n();
+        if (handler == null || image.isEmpty() || sid.isEmpty()) throw error;
+        CountDownLatch done = new CountDownLatch(1);
+        VKApiValidationHandler.a<String> callback = new VKApiValidationHandler.a<>(done);
+        handler.c(image, callback);
+        if (!done.await(5, TimeUnit.MINUTES)) throw error;
+        String solution = callback.b();
+        if (solution == null || solution.isEmpty()) throw error;
+        args.b(sid);
+        args.a(solution);
+    }
+
+    @SuppressWarnings("unchecked")
+    private static <E extends Throwable, T> T raise(Throwable error) throws E { throw (E) error; }
+}
diff --git a/app/src/main/java/ru/vtosters/hooks/ModernAuthFlow.java b/app/src/main/java/ru/vtosters/hooks/ModernAuthFlow.java
new file mode 100644
index 00000000..ea59bf7a
--- /dev/null
+++ b/app/src/main/java/ru/vtosters/hooks/ModernAuthFlow.java
@@ -0,0 +1,118 @@
+package ru.vtosters.hooks;
+
+import android.net.Uri;
+import com.vk.api.sdk.chain.ChainArgs;
+import java.io.IOException;
+import okhttp3.CacheControl;
+import okhttp3.FormBody;
+import okhttp3.Request;
+import org.json.JSONObject;
+
+/** Password transport used by the official Android client (8.193). */
+public final class ModernAuthFlow {
+    public interface Transport { String send(Request request) throws Exception; }
+    public interface Captcha { void solve(JSONObject error, ChainArgs args) throws Exception; }
+    private final Transport transport;
+    private final Captcha captcha;
+    private final String apiHost, version, language, device;
+    private String anonymousToken, identity;
+
+    public ModernAuthFlow(Transport transport, Captcha captcha, String apiHost,
+                          String version, String language, String device) {
+        this.transport = transport;
+        this.captcha = captcha;
+        this.apiHost = apiHost;
+        this.version = version;
+        this.language = language;
+        this.device = device;
+    }
+
+    // One executor owns one device's anonymous session; concurrent calls cannot mix it.
+    public synchronized String execute(String url, ChainArgs args) throws Exception {
+        Uri source = Uri.parse(url);
+        if (!"/token".equals(source.getPath()) || source.getQueryParameter("client_secret") == null) {
+            return transport.send(form(CaptchaHook.applyToUrl(url, args)));
+        }
+        String client = source.getQueryParameter("client_id");
+        String secret = source.getQueryParameter("client_secret");
+        String key = client + ":" + secret;
+        if (!key.equals(identity)) { anonymousToken = null; identity = key; }
+        for (int attempt = 0; attempt < 2; attempt++) {
+            if (anonymousToken == null) anonymousToken = acquire(source, client, secret);
+            Uri.Builder builder = copy(source, "client_id", "client_secret", "anonymous_token",
+                    "api_id", "https", "v", "lang", "device_id");
+            builder.appendQueryParameter("anonymous_token", anonymousToken);
+            common(builder, client);
+            String answer = transport.send(form(CaptchaHook.applyToUrl(builder.build().toString(), args)));
+            if (!needsAnonymousRefresh(new JSONObject(answer)) || attempt == 1) return answer;
+            anonymousToken = null;
+        }
+        throw new AssertionError("Unreachable");
+    }
+
+    public static boolean needsAnonymousRefresh(JSONObject answer) {
+        String error = answer.optString("error");
+        return "invalid_anonymous_token".equals(error) || "anonymous_token_has_expired".equals(error);
+    }
+
+    private String acquire(Uri source, String client, String secret) throws Exception {
+        Uri.Builder builder = new Uri.Builder().scheme("https").authority(apiHost)
+                .path("/method/auth.getAnonymToken");
+        common(builder, client);
+        builder.appendQueryParameter("client_id", client).appendQueryParameter("client_secret", secret);
+        JSONObject answer = anonymousAnswer(builder.build().toString());
+        JSONObject error = answer.optJSONObject("error");
+        // The official client keeps this fallback for servers without the API method.
+        if (error != null && error.optInt("error_code") == 3) {
+            builder = source.buildUpon().clearQuery().fragment(null).path("/get_anonym_token");
+            common(builder, client);
+            builder.appendQueryParameter("client_id", client).appendQueryParameter("client_secret", secret);
+            answer = anonymousAnswer(builder.build().toString());
+        }
+        JSONObject response = answer.optJSONObject("response");
+        Object token = (response == null ? answer : response).opt("token");
+        if (!(token instanceof String) || ((String) token).isEmpty()) {
+            throw new IOException("VK did not issue an anonymous authorization token");
+        }
+        return (String) token;
+    }
+
+    private JSONObject anonymousAnswer(String url) throws Exception {
+        ChainArgs args = new ChainArgs();
+        for (int attempt = 0; attempt < 3; attempt++) {
+            JSONObject answer = new JSONObject(transport.send(form(CaptchaHook.applyToUrl(url, args))));
+            JSONObject error = answer.optJSONObject("error");
+            if (error == null && "need_captcha".equals(answer.optString("error"))) error = answer;
+            if (error == null || !(error.optInt("error_code") == 14
+                    || "need_captcha".equals(error.optString("error")))) return answer;
+            if (attempt == 2) throw new IOException("VK anonymous captcha retry limit reached");
+            captcha.solve(error, args);
+        }
+        throw new AssertionError("Unreachable");
+    }
+
+    private void common(Uri.Builder builder, String client) {
+        builder.appendQueryParameter("api_id", client).appendQueryParameter("https", "1")
+                .appendQueryParameter("v", version).appendQueryParameter("lang", language);
+        if (device != null && !device.isEmpty()) builder.appendQueryParameter("device_id", device);
+    }
+
+    private static Uri.Builder copy(Uri source, String... excluded) {
+        Uri.Builder builder = source.buildUpon().clearQuery().fragment(null);
+        outer: for (String key : source.getQueryParameterNames()) {
+            for (String skip : excluded) if (skip.equals(key)) continue outer;
+            for (String value : source.getQueryParameters(key)) builder.appendQueryParameter(key, value);
+        }
+        return builder;
+    }
+
+    public static Request form(String url) {
+        Uri source = Uri.parse(url);
+        FormBody.a body = new FormBody.a();
+        for (String key : source.getQueryParameterNames()) {
+            for (String value : source.getQueryParameters(key)) body.a(key, value);
+        }
+        return new Request.a().b(source.buildUpon().clearQuery().fragment(null).build().toString())
+                .a(body.a()).a(CacheControl.n).a();
+    }
+}
diff --git a/app/src/main/java/ru/vtosters/lite/ui/activities/WebCaptchaActivity.java b/app/src/main/java/ru/vtosters/lite/ui/activities/WebCaptchaActivity.java
new file mode 100644
index 00000000..45dee232
--- /dev/null
+++ b/app/src/main/java/ru/vtosters/lite/ui/activities/WebCaptchaActivity.java
@@ -0,0 +1,202 @@
+package ru.vtosters.lite.ui.activities;
+
+import android.app.Activity;
+import android.hardware.Sensor;
+import android.hardware.SensorEvent;
+import android.hardware.SensorEventListener;
+import android.hardware.SensorManager;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.webkit.JavascriptInterface;
+import android.webkit.WebResourceError;
+import android.webkit.WebResourceRequest;
+import android.webkit.WebResourceResponse;
+import android.webkit.WebSettings;
+import android.webkit.WebView;
+import android.webkit.WebViewClient;
+import org.json.JSONException;
+import org.json.JSONArray;
+import org.json.JSONObject;
+import ru.vtosters.hooks.CaptchaHook;
+
+/** Displays VK's challenge for the user; never solves or skips it automatically. */
+public final class WebCaptchaActivity extends Activity implements SensorEventListener {
+    private String sessionId;
+    private WebView webView;
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private final Runnable expiry = this::finish;
+    private SensorManager sensors;
+    private JSONObject sensorConfig;
+    private final java.util.Map<Integer, String> sensorNames = new java.util.HashMap<>();
+    private boolean resumed;
+
+    @Override
+    protected void onCreate(Bundle state) {
+        super.onCreate(state);
+        sessionId = getIntent().getStringExtra("captcha_session");
+        String redirect = CaptchaHook.redirect(sessionId);
+        if (!CaptchaHook.isPending(sessionId) || !CaptchaHook.isTrustedUrl(redirect)) {
+            finish();
+            return;
+        }
+        setTitle("VK CAPTCHA");
+        sensors = (SensorManager) getSystemService(SENSOR_SERVICE);
+        webView = new WebView(this);
+        WebSettings settings = webView.getSettings();
+        settings.setJavaScriptEnabled(true);
+        settings.setDomStorageEnabled(true);
+        settings.setAllowFileAccess(false);
+        settings.setAllowContentAccess(false);
+        settings.setMixedContentMode(WebSettings.MIXED_CONTENT_NEVER_ALLOW);
+        webView.addJavascriptInterface(new Bridge(), "AndroidBridge");
+        webView.setWebViewClient(new WebViewClient() {
+            @Override
+            public boolean shouldOverrideUrlLoading(WebView view, String url) {
+                return !CaptchaHook.isTrustedUrl(url);
+            }
+
+            @Override
+            public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {
+                return !CaptchaHook.isTrustedUrl(request.getUrl().toString());
+            }
+
+            @Override
+            public void onReceivedError(WebView view, WebResourceRequest request, WebResourceError error) {
+                if (request.isForMainFrame()) finish();
+            }
+
+            @Override
+            public void onReceivedError(WebView view, int code, String description, String url) {
+                finish();
+            }
+
+            @Override
+            public void onReceivedHttpError(WebView view, WebResourceRequest request, WebResourceResponse response) {
+                if (request.isForMainFrame()) finish();
+            }
+        });
+        setContentView(webView);
+        webView.loadUrl(redirect);
+        handler.postDelayed(expiry, 5 * 60 * 1000L);
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        resumed = true;
+        startSensors();
+    }
+
+    @Override
+    protected void onPause() {
+        resumed = false;
+        stopSensors();
+        super.onPause();
+    }
+
+    private void stopSensors() {
+        if (sensors != null) sensors.unregisterListener(this);
+        sensorNames.clear();
+    }
+
+    private void startSensors() {
+        stopSensors();
+        if (!resumed || sensors == null || sensorConfig == null || !CaptchaHook.isPending(sessionId)) return;
+        JSONArray requested = sensorConfig.optJSONArray("bridge_sensors_list");
+        if (requested == null) return;
+        int period = Math.max(20, Math.min(1000, sensorConfig.optInt("period", 100)));
+        for (int i = 0; i < requested.length(); i++) {
+            String name = requested.optString(i);
+            int type;
+            switch (name) {
+                case "accelerometer": type = Sensor.TYPE_ACCELEROMETER; break;
+                case "gyroscope": type = Sensor.TYPE_GYROSCOPE; break;
+                case "motion": type = Sensor.TYPE_ROTATION_VECTOR; break;
+                default: continue;
+            }
+            Sensor sensor = sensors.getDefaultSensor(type);
+            if (sensor != null && sensors.registerListener(this, sensor, period * 1000, handler)) {
+                sensorNames.put(type, name);
+            }
+        }
+    }
+
+    @Override
+    public void onSensorChanged(SensorEvent event) {
+        String name = sensorNames.get(event.sensor.getType());
+        if (!resumed || name == null || event.values.length < 3 || webView == null) return;
+        try {
+            JSONObject values = new JSONObject();
+            String[] axes = "motion".equals(name)
+                    ? new String[]{"alpha", "beta", "gamma"} : new String[]{"x", "y", "z"};
+            for (int i = 0; i < axes.length; i++) values.put(axes[i], (double) event.values[i]);
+            JSONObject data = new JSONObject().put("detail", new JSONObject().put(name, values));
+            webView.evaluateJavascript("window.dispatchEvent(new CustomEvent('VKCaptchaListenSensorsChanged',"
+                    + data + "))", null);
+        } catch (JSONException ignored) {
+            // Never substitute manufactured readings for unavailable sensor data.
+        }
+    }
+
+    @Override
+    public void onAccuracyChanged(Sensor sensor, int accuracy) {}
+
+    @Override
+    protected void onDestroy() {
+        handler.removeCallbacks(expiry);
+        stopSensors();
+        if (!isChangingConfigurations()) CaptchaHook.complete(sessionId, null);
+        if (webView != null) {
+            webView.removeJavascriptInterface("AndroidBridge");
+            webView.stopLoading();
+            webView.destroy();
+        }
+        super.onDestroy();
+    }
+
+    /** Names and token payload follow VK Captcha's AndroidBridge contract. */
+    public final class Bridge {
+        @JavascriptInterface
+        public void VKCaptchaGetResult(String data) {
+            try {
+                Object value = new JSONObject(data).opt("token");
+                if (!(value instanceof String) || ((String) value).isEmpty()) return;
+                runOnUiThread(() -> {
+                    if (isFinishing() || isDestroyed()) return;
+                    CaptchaHook.complete(sessionId, (String) value);
+                    finish();
+                });
+            } catch (JSONException | NullPointerException ignored) {
+                // An invalid message must not turn into a successful challenge.
+            }
+        }
+
+        @JavascriptInterface
+        public void VKCaptchaCloseCaptcha(String data) {
+            runOnUiThread(WebCaptchaActivity.this::finish);
+        }
+
+        @JavascriptInterface
+        public void VKCaptchaListenSensorsStart(String data) {
+            try {
+                JSONObject config = new JSONObject(data);
+                runOnUiThread(() -> {
+                    if (isFinishing() || isDestroyed()) return;
+                    sensorConfig = config;
+                    startSensors();
+                });
+            } catch (JSONException | NullPointerException ignored) {
+                // Ignore malformed bridge requests.
+            }
+        }
+
+        @JavascriptInterface
+        public void VKCaptchaListenSensorsStop(String data) {
+            runOnUiThread(() -> {
+                sensorConfig = null;
+                stopSensors();
+            });
+        }
+    }
+}
diff --git a/docs/authentication.md b/docs/authentication.md
new file mode 100644
index 00000000..ce8f29de
--- /dev/null
+++ b/docs/authentication.md
@@ -0,0 +1,104 @@
+# Authentication and captcha compatibility
+
+## Confirmed in this repository
+
+The password flow uses `OAuthHttpUrlChainCall`. Previously `need_captcha`
+unconditionally read both `captcha_sid` and `captcha_img` using `getString`.
+An answer containing only a web `redirect_uri` therefore failed before showing
+a challenge. `VKErrorUtils` made the same assumption for API error 14.
+
+`BaseAuthPresenter.b(AuthAnswer)` maps the server's `error_type=too_much_tries`
+to the localized attempt-limit message. This message does not establish that a
+local counter or an expired client secret caused the rejection. The original
+response is needed to distinguish these cases.
+
+## Changes
+
+- Copy optional captcha fields without requiring an image.
+- Recognize both OAuth `need_captcha` and nested API error 14 during login.
+- Display a returned HTTPS challenge on VK domains in a non-exported WebView
+  Activity. The `AndroidBridge.VKCaptchaGetResult` callback accepts the user's
+  completion token. Closing, load failure, interruption and a five-minute timeout
+  terminate the wait without a successful result.
+- Retry the same OAuth/API chain with `success_token`. Image captchas continue
+  to use `captcha_sid` and `captcha_key`. Answers are isolated by request chain,
+  and stale answers are removed when switching challenge types.
+- Handle `X-Challenge: required` / `X-Challenge-Url` before parsing an OAuth
+  response, then retry the original request once with `X-Challenge-Solution`.
+  This does not loop on a persistent challenge or retry an attempt-limit error.
+
+## Comparison with the official Android application
+
+The reference is VK 8.193, versionCode 57318 (September 2026), package
+`com.vkontakte.android`, arm64 APK. Its signing certificate SHA-1 is
+`48761eef50ee53afc4cc9c5f10e6bde7f8f5b82f`, matching the release certificate
+listed in VK's published `TrustedProvidersCache.kt`.
+
+The APK manifest still contains app ID **2274003**, and its embedded client key
+matches Lite's existing `ApiConfig` key. There is no evidence here of a revoked
+or changed key. Registering a separate third-party VK ID application is not a
+prerequisite for this compatibility patch.
+
+The examined classes (original Kotlin source names) establish this sequence:
+
+1. `GetAnonymousTokenApiCommand` requests `auth.getAnonymToken` with the existing
+   client ID/key and device ID. `AnonymousTokenRequest` retains the OAuth
+   `/get_anonym_token` fallback. This patch limits that fallback to error 3
+   (unknown API method), and does not mask other server rejections.
+2. `BaseAuthCommand` sends `anonymous_token` instead of `client_id/client_secret`
+   when an anonymous token is available. Its request is a URL-encoded POST body,
+   including API version, language, device ID, `https=1` and `api_id`.
+3. `AuthRequest` and `VkAuthState` still support `grant_type=password`, username,
+   password and existing verification parameters. An anonymous token is refreshed
+   only for `invalid_anonymous_token` or `anonymous_token_has_expired`.
+
+`ModernAuthExecutor` is wired into `VKAuthApiManager` through its existing
+executor factory. It keeps Lite's HTTP provider and verification UI.
+`ModernAuthFlow` implements the anonymous-session preflight, form transport,
+per-executor cache and one bounded anonymous-token refresh. It preserves existing
+password, code, sid and captcha parameters. Preflight challenges use a separate
+captcha chain, so their answers do not leak into the password request.
+No password, rate-limit or `invalid_client` rejection is retried automatically.
+No request attestation is fabricated or captcha solved automatically.
+
+The new APK also contains `auth.validateAccount` and additional phone-first,
+passkey and VK Connect routes. Those are not reproduced wholesale: Lite retains
+its password UI and existing two-factor flow, with the current password transport.
+If VK rejects that route for a particular account, these changes cannot promise
+that a different server-selected verification route will work in Lite.
+
+## Verification and remaining device checks
+
+Run the standalone suite as described in [tests/auth](../tests/auth/README.md).
+The captcha tests cover the native bridge contract, optional fields, trusted
+navigation, answer isolation and header challenges. The transport tests use
+recorded response shapes and inspect actual OkHttp requests: form encoding,
+Unicode and repeated parameters, anonymous preflight/cache/refresh, verification
+continuation, fallback, failure termination and captcha isolation.
+They do not send account credentials or log in to VK.
+
+A complete previous captcha-only build passed JDK 17 compilation, Android lint,
+DEX generation, APK assembly and signature verification in GitHub Actions.
+The updated anonymous-session build is checked by the same workflow.
+
+On a device, verify image captcha, web captcha, cancellation/back, rotation,
+network failure, two successive challenges and successful token delivery. Test
+both login and a normal API request. The native sensor bridge reads only the
+requested accelerometer, gyroscope and rotation-vector sensors while the captcha
+Activity is resumed, and unregisters on pause/close. Hardware sensor behavior and
+any domain outside the explicit VK allowlist need device verification.
+No real login or interactive challenge was available in this environment, so a
+successful sign-in, and resolution of `too_much_tries`, are not verified.
+
+## Protocol references
+
+- [VK Captcha Android result contract](https://cloud.vk.ru/docs/en/security/captcha/concepts/reference-sdk/reference-sdk-android)
+- [VK ID SDK error-14 retry](https://github.com/VKCOM/vkid-android-sdk/blob/master/sdk/core/network/src/main/kotlin/com/vk/id/network/http/captcha/Error14HandlingInterceptor.kt)
+- [VK ID SDK header challenge retry](https://github.com/VKCOM/vkid-android-sdk/blob/master/sdk/core/network/src/main/kotlin/com/vk/id/network/http/captcha/HitmanChallengeHandlingInterceptor.kt)
+- Native bridge callback names were checked against VK's published
+  `com.vk.id.captcha:vkid-captcha:0.0.16` artifact. The SDK is not added as a runtime
+  dependency because this application merges Java dex files into a decompiled
+  APK and contains an older, renamed Kotlin runtime.
+
+- [Official VK 8.193 APK source](https://apkpure.com/vk-music-video-messenger/com.vkontakte.android/download/8.193)
+- [VK official-app certificate in the published SDK](https://github.com/VKCOM/vkid-android-sdk/blob/master/sdk/core/vkid/src/main/java/com/vk/id/internal/auth/app/TrustedProvidersCache.kt)
