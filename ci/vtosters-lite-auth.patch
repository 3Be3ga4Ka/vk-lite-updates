--- /dev/null
+++ b/app/src/main/java/ru/vtosters/hooks/CaptchaHook.java
@@ -0,0 +1,192 @@
+package ru.vtosters.hooks;
+
+import android.content.Intent;
+import android.net.Uri;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import com.vk.api.sdk.chain.ChainArgs;
+import com.vk.api.sdk.exceptions.VKApiExecutionException;
+import com.vk.api.sdk.okhttp.OkHttpMethodCall;
+import org.json.JSONObject;
+import okhttp3.Request;
+import okhttp3.Response;
+import ru.vtosters.lite.ui.activities.WebCaptchaActivity;
+import ru.vtosters.lite.utils.AndroidUtils;
+
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.UUID;
+import java.util.WeakHashMap;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.io.IOException;
+import java.net.URI;
+
+/** Bridges redirect_uri challenges into the old SDK's per-request retry chain. */
+public final class CaptchaHook {
+    private static final Map<ChainArgs, String> SOLUTIONS =
+            Collections.synchronizedMap(new WeakHashMap<>());
+    private static final Map<String, Session> SESSIONS = new ConcurrentHashMap<>();
+    private static final String[] ANSWER_KEYS = {"captcha_sid", "captcha_key", "success_token"};
+
+    private CaptchaHook() {}
+
+    public static Bundle extras(JSONObject error) {
+        Bundle result = new Bundle();
+        for (String key : new String[]{"captcha_sid", "captcha_img", "redirect_uri"}) {
+            Object value = error.opt(key);
+            if (value instanceof String) result.putString(key, (String) value);
+        }
+        return result;
+    }
+
+    public static void checkOAuthCaptcha(JSONObject response) throws VKApiExecutionException {
+        JSONObject error = response.optJSONObject("error");
+        if (error != null && error.optInt("error_code") == 14) {
+            throw new VKApiExecutionException(14, "oauth", false, "need_captcha", extras(error), null, null);
+        }
+    }
+
+    /** Header challenges precede JSON OAuth errors. Retry only the original request. */
+    public static Request challengeRequest(Response response) throws IOException, InterruptedException {
+        if (!"required".equals(response.a("X-Challenge"))) return null;
+        String challenge = response.a("X-Challenge-Url");
+        Request original = response.o();
+        response.close();
+        if (challenge == null || challenge.isEmpty()) throw new IOException("Missing VK challenge URL");
+        String redirect;
+        try {
+            redirect = URI.create(original.g().toString()).resolve(challenge).toString();
+        } catch (IllegalArgumentException exception) {
+            throw new IOException("Invalid VK challenge URL", exception);
+        }
+        String token = request(redirect);
+        if (token == null || token.isEmpty()) throw new IOException("VK challenge cancelled or unavailable");
+        return original.f().b("X-Challenge-Solution", token).a();
+    }
+
+    public static boolean handle(VKApiExecutionException error, ChainArgs args)
+            throws VKApiExecutionException, InterruptedException {
+        SOLUTIONS.remove(args);
+        Bundle extra = error.h();
+        String redirect = extra == null ? null : extra.getString("redirect_uri");
+        if (redirect == null || redirect.isEmpty()) return false;
+        String token = request(redirect);
+        if (token == null || token.isEmpty()) throw error;
+        // Clear a previous image answer if the server switched challenge types.
+        args.a("");
+        args.b("");
+        SOLUTIONS.put(args, token);
+        return true;
+    }
+
+    public static String request(String redirect) throws InterruptedException {
+        if (!isTrustedUrl(redirect) || Looper.myLooper() == Looper.getMainLooper()) return null;
+        String id = UUID.randomUUID().toString();
+        Session session = new Session(redirect);
+        SESSIONS.put(id, session);
+        try {
+            new Handler(Looper.getMainLooper()).post(() -> {
+                if (!isPending(id)) return;
+                try {
+                    Intent intent = new Intent(AndroidUtils.getGlobalContext(), WebCaptchaActivity.class);
+                    intent.putExtra("captcha_session", id);
+                    intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+                    AndroidUtils.getGlobalContext().startActivity(intent);
+                } catch (RuntimeException exception) {
+                    complete(id, null);
+                }
+            });
+            if (!session.done.await(5, TimeUnit.MINUTES)) return null;
+            return session.token;
+        } finally {
+            SESSIONS.remove(id);
+        }
+    }
+
+    public static String redirect(String id) {
+        Session session = id == null ? null : SESSIONS.get(id);
+        return session == null ? null : session.redirect;
+    }
+
+    public static boolean isPending(String id) {
+        Session session = id == null ? null : SESSIONS.get(id);
+        return session != null && session.done.getCount() != 0;
+    }
+
+    public static void complete(String id, String token) {
+        Session session = id == null ? null : SESSIONS.get(id);
+        if (session != null) {
+            synchronized (session) {
+                if (session.done.getCount() == 0) return;
+                session.token = token;
+                session.done.countDown();
+            }
+        }
+    }
+
+    public static boolean isTrustedUrl(String url) {
+        if (url == null) return false;
+        Uri uri = Uri.parse(url);
+        String host = uri.getHost();
+        if (!"https".equalsIgnoreCase(uri.getScheme()) || host == null
+                || uri.getUserInfo() != null || (uri.getPort() != -1 && uri.getPort() != 443)) return false;
+        host = host.toLowerCase(java.util.Locale.ROOT);
+        for (String domain : new String[]{"vk.com", "vk.ru", "vkcaptcha.ru"}) {
+            if (host.equals(domain) || host.endsWith("." + domain)) return true;
+        }
+        return false;
+    }
+
+    private static Map<String, String> answer(ChainArgs args) {
+        Map<String, String> answer = new HashMap<>();
+        if (args == null) return answer;
+        String token = SOLUTIONS.get(args);
+        if (token != null) {
+            answer.put("success_token", token);
+        } else if (args.d()) {
+            answer.put("captcha_sid", args.b());
+            answer.put("captcha_key", args.a());
+        }
+        return answer;
+    }
+
+    public static String applyToUrl(String url, ChainArgs args) {
+        Map<String, String> answer = answer(args);
+        if (answer.isEmpty()) return url;
+        Uri source = Uri.parse(url);
+        Uri.Builder builder = source.buildUpon().clearQuery();
+        for (String key : source.getQueryParameterNames()) {
+            if (isAnswerKey(key)) continue;
+            for (String value : source.getQueryParameters(key)) builder.appendQueryParameter(key, value);
+        }
+        for (Map.Entry<String, String> entry : answer.entrySet()) {
+            builder.appendQueryParameter(entry.getKey(), entry.getValue());
+        }
+        return builder.build().toString();
+    }
+
+    public static void applyToCall(OkHttpMethodCall.a call, ChainArgs args) {
+        Map<String, String> answer = answer(args);
+        if (answer.isEmpty()) return;
+        // The builder survives retries: remove the preceding challenge's answer.
+        for (String key : ANSWER_KEYS) call.b().remove(key);
+        call.a(answer);
+    }
+
+    private static boolean isAnswerKey(String key) {
+        for (String candidate : ANSWER_KEYS) if (candidate.equals(key)) return true;
+        return false;
+    }
+
+    private static final class Session {
+        final String redirect;
+        final CountDownLatch done = new CountDownLatch(1);
+        volatile String token;
+
+        Session(String redirect) { this.redirect = redirect; }
+    }
+}
