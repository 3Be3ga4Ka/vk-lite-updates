+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+: "${ANDROID_JAR:?Set ANDROID_JAR to Android SDK platform 32 android.jar}"
+: "${ANDROID_ALL_JAR:?Set ANDROID_ALL_JAR to Robolectric android-all 12.1 jar}"
+test_output=$(mktemp -d)
+trap 'rm -rf "$test_output"' EXIT
+test_libraries=$(find app/libs -maxdepth 1 -name '*.jar' -printf '%p:' | sed 's/:$//')
+compiler=(javac)
+if [[ -n "${ECJ_JAR:-}" ]]; then
+    compiler=(java -jar "$ECJ_JAR")
+fi
+"${compiler[@]}" -source 8 -target 8 -proc:none \
+    -cp "$ANDROID_JAR:$test_libraries" -sourcepath tests/auth/stubs -d "$test_output" \
+    tests/auth/stubs/ru/vtosters/lite/utils/AndroidUtils.java \
+    app/src/main/java/ru/vtosters/hooks/CaptchaHook.java \
+    app/src/main/java/ru/vtosters/lite/ui/activities/WebCaptchaActivity.java \
+    app/src/main/java/ru/vtosters/hooks/ModernAuthFlow.java \
+    app/src/main/java/ru/vtosters/hooks/ModernAuthExecutor.java \
+    tests/auth/ModernAuthFlowTest.java \
+    tests/auth/CaptchaHookTest.java
+java -cp "$test_output:$ANDROID_ALL_JAR:$test_libraries" CaptchaHookTest
+java -cp "$test_output:$ANDROID_ALL_JAR:$test_libraries" ModernAuthFlowTest
diff --git a/tests/auth/CaptchaHookTest.java b/tests/auth/CaptchaHookTest.java
new file mode 100644
index 00000000..be8cabeb
--- /dev/null
+++ b/tests/auth/CaptchaHookTest.java
@@ -0,0 +1,171 @@
+import android.net.Uri;
+import android.os.Bundle;
+import com.vk.api.sdk.chain.ChainArgs;
+import com.vk.api.sdk.exceptions.VKApiExecutionException;
+import com.vk.api.sdk.okhttp.OkHttpMethodCall;
+import org.json.JSONObject;
+import okhttp3.Protocol;
+import okhttp3.Request;
+import okhttp3.Response;
+import okhttp3.ResponseBody;
+import ru.vtosters.hooks.CaptchaHook;
+
+import java.lang.reflect.Constructor;
+import java.lang.reflect.Field;
+import java.util.Map;
+
+/** Standalone regression tests, without a VK account or network requests. */
+public final class CaptchaHookTest {
+    private static int checks;
+
+    private static void check(boolean condition) {
+        checks++;
+        if (!condition) throw new AssertionError("Check " + checks + " failed");
+    }
+
+    @SuppressWarnings("unchecked")
+    private static Map<ChainArgs, String> solutions() throws Exception {
+        Field field = CaptchaHook.class.getDeclaredField("SOLUTIONS");
+        field.setAccessible(true);
+        return (Map<ChainArgs, String>) field.get(null);
+    }
+
+    public static void main(String[] args) throws Exception {
+        Bundle web = CaptchaHook.extras(new JSONObject("{\"redirect_uri\":\"https://vk.com/captcha\"}"));
+        check("https://vk.com/captcha".equals(web.getString("redirect_uri")));
+        check(!web.containsKey("captcha_img"));
+        Bundle legacy = CaptchaHook.extras(new JSONObject("{\"captcha_sid\":\"123\",\"captcha_img\":\"https://vk.com/image\"}"));
+        check("123".equals(legacy.getString("captcha_sid")));
+        check("https://vk.com/image".equals(legacy.getString("captcha_img")));
+        check(CaptchaHook.extras(new JSONObject("{\"redirect_uri\":null,\"captcha_img\":7}")).isEmpty());
+
+        try {
+            CaptchaHook.checkOAuthCaptcha(new JSONObject("{\"error\":{\"error_code\":14,\"redirect_uri\":\"https://vk.com/captcha\"}}"));
+            throw new AssertionError("Nested captcha was ignored");
+        } catch (VKApiExecutionException error) {
+            check(error.d() == 14);
+            check("https://vk.com/captcha".equals(error.h().getString("redirect_uri")));
+        }
+        CaptchaHook.checkOAuthCaptcha(new JSONObject("{\"error\":\"invalid_client\",\"error_type\":\"too_much_tries\"}"));
+        CaptchaHook.checkOAuthCaptcha(new JSONObject("{\"error\":{\"error_code\":5}}"));
+
+        for (String url : new String[]{"https://vk.com/captcha", "https://api.vk.com/captcha", "https://id.vk.ru/captcha", "https://VK.COM/captcha"}) {
+            check(CaptchaHook.isTrustedUrl(url));
+        }
+        for (String url : new String[]{"http://vk.com/captcha", "https://vk.com.evil.test/captcha", "https://evilvk.com/", "https://evil.test/?vk.com", "https://evil.test@vk.com/", "https://vk.com:444/", "file:///vk.com", "javascript:alert(1)", "", null}) {
+            check(!CaptchaHook.isTrustedUrl(url));
+        }
+
+        String original = "https://oauth.vk.com/token?username=a%2Bb&password=p%26q%3D%D1%8F&scope=all&scope=offline#fragment";
+        ChainArgs chain = new ChainArgs();
+        check(original.equals(CaptchaHook.applyToUrl(original, chain)));
+        chain.b("sid");
+        chain.a("a+b&c");
+        Uri retry = Uri.parse(CaptchaHook.applyToUrl(original, chain));
+        check("a+b".equals(retry.getQueryParameter("username")));
+        check("p&q=я".equals(retry.getQueryParameter("password")));
+        check(retry.getQueryParameters("scope").size() == 2);
+        check("fragment".equals(retry.getFragment()));
+        check("sid".equals(retry.getQueryParameter("captcha_sid")));
+        check("a+b&c".equals(retry.getQueryParameter("captcha_key")));
+
+        // A successful UI result belongs only to its request chain.
+        solutions().put(chain, "web+token&value");
+        retry = Uri.parse(CaptchaHook.applyToUrl(original.replace("#fragment",
+                "&captcha_key=stale&captcha_sid=stale&success_token=stale#fragment"), chain));
+        check("web+token&value".equals(retry.getQueryParameter("success_token")));
+        check(retry.getQueryParameter("captcha_sid") == null);
+        check(retry.getQueryParameter("captcha_key") == null);
+        check(retry.getQueryParameters("success_token").size() == 1);
+        check(original.equals(CaptchaHook.applyToUrl(original, new ChainArgs())));
+
+        OkHttpMethodCall.a call = new OkHttpMethodCall.a();
+        call.a("username", "a+b");
+        call.a("captcha_sid", "stale");
+        call.a("captcha_key", "stale");
+        CaptchaHook.applyToCall(call, chain);
+        check("web+token&value".equals(call.a("success_token")));
+        check(call.a("captcha_sid") == null && call.a("captcha_key") == null);
+        check("a+b".equals(call.a("username")));
+
+        VKApiExecutionException imageError = new VKApiExecutionException(14, "test", false, "captcha", legacy, null, null);
+        check(!CaptchaHook.handle(imageError, chain));
+        CaptchaHook.applyToCall(call, chain);
+        check(call.a("success_token") == null);
+        check("sid".equals(call.a("captcha_sid")));
+        check("a+b&c".equals(call.a("captcha_key")));
+
+        // An untrusted challenge cancels; it never falls through to the image UI.
+        Bundle untrusted = new Bundle();
+        untrusted.putString("redirect_uri", "https://evil.test/captcha");
+        VKApiExecutionException invalid = new VKApiExecutionException(14, "test", false, "captcha", untrusted, null, null);
+        try {
+            CaptchaHook.handle(invalid, chain);
+            throw new AssertionError("Untrusted challenge accepted");
+        } catch (VKApiExecutionException error) {
+            check(error == invalid);
+        }
+
+        testSessionCompletion();
+        testHeaderChallenges();
+        System.out.println("Passed " + checks + " captcha regression checks");
+    }
+
+    private static Response response(int status, String challenge, String url) {
+        Request request = new Request.a().b("https://oauth.vk.com/token?username=test").a();
+        Response.a builder = new Response.a().a(request).a(Protocol.HTTP_1_1)
+                .a(status).a("test").a(ResponseBody.a(null, new byte[]{1, 2, 3}));
+        if (challenge != null) builder.a("X-Challenge", challenge);
+        if (url != null) builder.a("X-Challenge-Url", url);
+        return builder.a();
+    }
+
+    private static void testHeaderChallenges() throws Exception {
+        // Status alone is never a reason to open a challenge or retry a password.
+        try (Response response = response(429, null, null)) {
+            check(CaptchaHook.challengeRequest(response) == null);
+            check(response.a().g().length() == 3);
+        }
+        try (Response response = response(200, "optional", "https://vk.com/captcha")) {
+            check(CaptchaHook.challengeRequest(response) == null);
+        }
+        for (String redirect : new String[]{null, "https://evil.test/captcha", "http://vk.com/captcha"}) {
+            try (Response response = response(429, "required", redirect)) {
+                try {
+                    CaptchaHook.challengeRequest(response);
+                    throw new AssertionError("Invalid challenge URL accepted");
+                } catch (java.io.IOException expected) {
+                    check(true);
+                }
+            }
+        }
+    }
+
+    @SuppressWarnings("unchecked")
+    private static void testSessionCompletion() throws Exception {
+        Class<?> type = Class.forName("ru.vtosters.hooks.CaptchaHook$Session");
+        Constructor<?> constructor = type.getDeclaredConstructor(String.class);
+        constructor.setAccessible(true);
+        Object session = constructor.newInstance("https://vk.com/captcha");
+        Field sessionsField = CaptchaHook.class.getDeclaredField("SESSIONS");
+        sessionsField.setAccessible(true);
+        Map<String, Object> sessions = (Map<String, Object>) sessionsField.get(null);
+        sessions.put("test", session);
+        try {
+            check(CaptchaHook.isPending("test"));
+            check("https://vk.com/captcha".equals(CaptchaHook.redirect("test")));
+            CaptchaHook.complete("test", "first");
+            CaptchaHook.complete("test", null);
+            check(!CaptchaHook.isPending("test"));
+            Field token = type.getDeclaredField("token");
+            token.setAccessible(true);
+            check("first".equals(token.get(session)));
+        } finally {
+            sessions.remove("test");
+        }
+        check(!CaptchaHook.isPending("test"));
+        check(!CaptchaHook.isPending(null));
+        check(CaptchaHook.redirect(null) == null);
+        CaptchaHook.complete(null, "ignored");
+    }
+}
diff --git a/tests/auth/ModernAuthFlowTest.java b/tests/auth/ModernAuthFlowTest.java
new file mode 100644
index 00000000..ca79cffd
--- /dev/null
+++ b/tests/auth/ModernAuthFlowTest.java
@@ -0,0 +1,94 @@
+import com.vk.api.sdk.chain.ChainArgs;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.List;
+import okhttp3.FormBody;
+import okhttp3.Request;
+import org.json.JSONObject;
+import ru.vtosters.hooks.ModernAuthFlow;
+
+/** Recorded protocol responses only; no credentials, account or VK requests. */
+public final class ModernAuthFlowTest {
+    private static int checks;
+    private static final String LOGIN = "https://oauth.vk.com/token?client_id=2274003&client_secret=test-only"
+            + "&grant_type=password&username=a%2Bb&password=p%26q%3D%D1%8F&2fa_supported=1"
+            + "&supported_ways%5B%5D=push&supported_ways%5B%5D=email&scope=all&scope=offline";
+    private static void check(boolean value) { checks++; if (!value) throw new AssertionError("Check " + checks); }
+    private static String field(Request request, String key) {
+        FormBody body = (FormBody) request.a();
+        for (int i = 0; i < body.c(); i++) if (key.equals(body.a(i))) return body.c(i);
+        return null;
+    }
+    private static final class Server implements ModernAuthFlow.Transport {
+        final List<Request> requests = new ArrayList<>();
+        final String[] replies;
+        Server(String... replies) { this.replies = replies; }
+        public String send(Request request) {
+            check(!request.g().toString().contains("?"));
+            check("POST".equals(request.e()));
+            requests.add(request);
+            if (requests.size() > replies.length) throw new AssertionError("Unexpected retry");
+            return replies[requests.size()-1];
+        }
+    }
+    private static ModernAuthFlow flow(Server server) {
+        return new ModernAuthFlow(server, (error,args) -> { throw new AssertionError("Unexpected captcha"); },
+                "api.vk.com", "5.131", "ru", "device-test");
+    }
+    public static void main(String[] unused) throws Exception {
+        Server server = new Server("{\"response\":{\"token\":\"anon-test\"}}", "{\"access_token\":\"test\"}",
+                "{\"error\":\"need_validation\",\"validation_sid\":\"sid\"}");
+        ModernAuthFlow flow = flow(server);
+        check(flow.execute(LOGIN, new ChainArgs()).contains("access_token"));
+        Request preflight = server.requests.get(0), token = server.requests.get(1);
+        check(preflight.g().toString().equals("https://api.vk.com/method/auth.getAnonymToken"));
+        check("2274003".equals(field(preflight,"client_id")));
+        check("test-only".equals(field(preflight,"client_secret")));
+        check(field(preflight,"password") == null);
+        check(token.g().toString().equals("https://oauth.vk.com/token"));
+        check(field(token,"client_secret") == null && field(token,"client_id") == null);
+        check("anon-test".equals(field(token,"anonymous_token")));
+        check("2274003".equals(field(token,"api_id")));
+        check("device-test".equals(field(token,"device_id")));
+        check("5.131".equals(field(token,"v")));
+        check("a+b".equals(field(token,"username")));
+        check("p&q=я".equals(field(token,"password")));
+        FormBody body = (FormBody)token.a();
+        int scopes=0, ways=0;
+        for(int i=0;i<body.c();i++){ if(body.a(i).equals("scope"))scopes++; if(android.net.Uri.decode(body.a(i)).equals("supported_ways[]"))ways++; }
+        check(scopes==2 && ways==2);
+        ChainArgs image = new ChainArgs(); image.a("answer"); image.b("image-sid");
+        check(flow.execute(LOGIN+"&code=123456&sid=validation", image).contains("need_validation"));
+        check(server.requests.size()==3);
+        check("image-sid".equals(field(server.requests.get(2),"captcha_sid")));
+        check("123456".equals(field(server.requests.get(2),"code")));
+        check("validation".equals(field(server.requests.get(2),"sid")));
+        for(String error : new String[]{"invalid_client","too_many_requests","need_validation","need_captcha"}){
+            Server rejected = new Server("{\"response\":{\"token\":\"anon\"}}", "{\"error\":\""+error+"\"}");
+            check(flow(rejected).execute(LOGIN,new ChainArgs()).contains(error));
+            check(rejected.requests.size()==2);
+        }
+        Server refresh = new Server("{\"response\":{\"token\":\"old\"}}", "{\"error\":\"invalid_anonymous_token\"}",
+                "{\"response\":{\"token\":\"fresh\"}}", "{\"error\":\"anonymous_token_has_expired\"}");
+        check(flow(refresh).execute(LOGIN,new ChainArgs()).contains("anonymous_token_has_expired"));
+        check(refresh.requests.size()==4);
+        check("fresh".equals(field(refresh.requests.get(3),"anonymous_token")));
+        Server fallback = new Server("{\"error\":{\"error_code\":3}}", "{\"token\":\"fallback\"}", "{}");
+        flow(fallback).execute(LOGIN,new ChainArgs());
+        check(fallback.requests.get(1).g().toString().equals("https://oauth.vk.com/get_anonym_token"));
+        check("fallback".equals(field(fallback.requests.get(2),"anonymous_token")));
+        for(String reply:new String[]{"{\"response\":{}}","{\"error\":{\"error_code\":5}}","{\"token\":123}"}) {
+            Server failed = new Server(reply);
+            try {flow(failed).execute(LOGIN,new ChainArgs()); throw new AssertionError("Missing token accepted");}
+            catch(IOException expected){check(failed.requests.size()==1);}
+        }
+        Server challenged = new Server("{\"error\":{\"error_code\":14,\"captcha_sid\":\"anon-sid\",\"captcha_img\":\"https://vk.com/image\"}}",
+                "{\"response\":{\"token\":\"anon\"}}", "{}");
+        new ModernAuthFlow(challenged,(error,args)->{args.a("human-answer");args.b(error.getString("captcha_sid"));},
+                "api.vk.com","5.131","ru","device-test").execute(LOGIN,new ChainArgs());
+        check("human-answer".equals(field(challenged.requests.get(1),"captcha_key")));
+        check(field(challenged.requests.get(2),"captcha_key")==null);
+        check(!ModernAuthFlow.needsAnonymousRefresh(new JSONObject("{\"error\":\"invalid_client\",\"error_type\":\"too_much_tries\"}")));
+        System.out.println("Modern auth: " + checks + " checks passed");
+    }
+}
